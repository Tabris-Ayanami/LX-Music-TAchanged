<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="PageRoot"
    x:Class="LXTA_Native.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LXTA_Native.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <AcrylicBrush x:Key="GlassBrush"
                      TintColor="#F6FAFF"
                      TintOpacity="0.67"
                      TintLuminosityOpacity="0.86"
                      FallbackColor="#F1F6FC" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#9AC7DCF5" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6F7F94" />
        <LinearGradientBrush x:Key="ActiveBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#75AFFF" Offset="0" />
            <GradientStop Color="#2F75D6" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Foreground" Value="#26364A" />
        </Style>
        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="#DDF7FAFF" />
            <Setter Property="BorderBrush" Value="#8DC7DDF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#203047" />
        </Style>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#BDF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="17,7" />
            <Setter Property="Background" Value="#A9C8DEFA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#223249" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <DataTemplate x:Key="RailCoverTemplate">
            <Border Width="48" Height="48" Margin="0,5" CornerRadius="13" Background="#DCEAF6">
                <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="17" Foreground="#7B8DA3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding PictureUrl}" Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TrackCardTemplate">
            <Border Style="{StaticResource GlassCardStyle}" Margin="7" Padding="14" Height="196">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="14" Background="#D9E6F4">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="42" Foreground="#8DA2B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding PictureUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{Binding Singer}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AlbumName}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="17" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Source}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Duration}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlbumTileTemplate">
            <Border Style="{StaticResource GlassCardStyle}" Margin="8" Padding="9" Height="222">
                <Grid RowSpacing="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="164" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="13" Background="#D9E6F4">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="38" Foreground="#8DA2B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding PictureUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Singer}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistTemplate">
            <Grid MinHeight="70" Padding="5" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="13" Background="#D9E7F7">
                    <FontIcon Glyph="&#xE8A5;" FontSize="21" Foreground="#4679B9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TrackCountText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrackRowTemplate">
            <Grid MinHeight="66" Padding="7,5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="11" Background="#D9E6F4">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="17" Foreground="#879CB2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding PictureUrl}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Singer}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Source}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DownloadTemplate">
            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <ProgressBar Grid.Column="1" Value="{Binding ProgressPercent}" Maximum="100" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="继续" Command="{Binding DataContext.ViewModel.ResumeDownloadCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootPage">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6F5FAFF" Offset="0" />
                <GradientStop Color="#D8EDF5FF" Offset="0.55" />
                <GradientStop Color="#CFE2EFFB" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="98" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Original compact navigation rail -->
        <Border Grid.RowSpan="2" Background="#7DF7FAFF" BorderBrush="#79C5D9EE" BorderThickness="0,0,1,0">
            <Grid Margin="0,36,0,18">
                <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource ActiveBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Row="1" Spacing="2">
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonStyle}" Content="&#xE721;" Click="HomeNav_Click" ToolTipService.ToolTip="搜索" AutomationProperties.Name="搜索" />
                    <Button x:Name="PlaylistNavButton" Style="{StaticResource NavButtonStyle}" Content="&#xE8A5;" Click="PlaylistsNav_Click" ToolTipService.ToolTip="歌单" AutomationProperties.Name="歌单" />
                    <Button x:Name="DownloadsNavButton" Style="{StaticResource NavButtonStyle}" Content="&#xE896;" Click="DownloadsNav_Click" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载" />
                    <Button x:Name="LocalNavButton" Style="{StaticResource NavButtonStyle}" Content="&#xE93C;" Click="LocalNav_Click" ToolTipService.ToolTip="本地音乐" AutomationProperties.Name="本地音乐" />
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Content="&#xE713;" Click="SettingsNav_Click" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="&#xEB51;" Click="Settings_Click" ToolTipService.ToolTip="收藏与功能" AutomationProperties.Name="收藏与功能" />
                </StackPanel>
                <Border Grid.Row="2" Margin="26,16" Background="#769BB1C9" />
                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Tracks}"
                          ItemTemplate="{StaticResource RailCoverTemplate}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="Track_ItemClick"
                          HorizontalContentAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,6,0,0" />
            </Grid>
        </Border>

        <!-- Integrated top bar -->
        <Grid Grid.Column="1" Padding="28,14,176,10" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="440" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Height="60" CornerRadius="30" Background="{StaticResource GlassBrush}" BorderBrush="#9DC7DCF3" BorderThickness="1" VerticalAlignment="Center">
                <Grid Padding="18,0,8,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    PlaceholderText="Search for something..."
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="作曲: 常田大希" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#78879A" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ToggleSwitch x:Name="HeaderThemeToggle" OffContent="" OnContent="" Width="80" ToolTipService.ToolTip="明暗主题" />
                <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE713;" Click="Settings_Click" ToolTipService.ToolTip="外观设置" AutomationProperties.Name="外观设置" />
                <Ellipse Width="20" Height="20" Fill="#FFBE31" />
                <Ellipse Width="20" Height="20" Fill="#24C866" />
                <Ellipse Width="20" Height="20" Fill="#FF6063" />
            </StackPanel>
        </Grid>

        <!-- Main content surfaces -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="28,18,28,144">
            <Grid x:Name="HomePanel" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="144" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Border Style="{StaticResource GlassCardStyle}" HorizontalAlignment="Left" Padding="7" CornerRadius="30">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Content="酷我音乐" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="酷狗音乐" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="企鹅音乐" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="网易音乐" Style="{StaticResource ChipButtonStyle}" Background="{StaticResource ActiveBlueBrush}" Foreground="White" />
                            <Button Content="咪咕音乐" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="B站音乐" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="聚合搜索" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Right" Style="{StaticResource GlassCardStyle}" Padding="6" CornerRadius="28">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="歌曲" Style="{StaticResource ChipButtonStyle}" Background="{StaticResource ActiveBlueBrush}" Foreground="White" />
                            <Button Content="歌单" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBlock Text="热门搜索" FontSize="17" FontWeight="SemiBold" Foreground="#314158" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="甲乙丙丁" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="海屿你" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="petal" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="失眠" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="刻在我心底的名字" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="碎碎念" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="晨间新闻" Style="{StaticResource ChipButtonStyle}" />
                        <Button Content="The Blame" Style="{StaticResource ChipButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="歌曲与本地结果" FontSize="17" FontWeight="SemiBold" Foreground="#314158" Margin="0,6,0,0" />
                </StackPanel>
                <GridView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Tracks}"
                          ItemTemplate="{StaticResource TrackCardTemplate}"
                          IsItemClickEnabled="True"
                          ItemClick="Track_ItemClick"
                          SelectionMode="None"
                          HorizontalContentAlignment="Stretch">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="520" ItemHeight="210" /></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView>
            </Grid>

            <Grid x:Name="PlaylistPanel" Visibility="Collapsed" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="默认  " Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                            <Button Content="最新" Style="{StaticResource ChipButtonStyle}" Background="{StaticResource ActiveBlueBrush}" Foreground="White" />
                            <Button Content="最热" Style="{StaticResource ChipButtonStyle}" Background="Transparent" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="新建歌单" Click="CreatePlaylist_Click" />
                            <Button Content="刷新" Click="Refresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="我的歌单" FontSize="20" FontWeight="SemiBold" Margin="8" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Playlists}" ItemTemplate="{StaticResource PlaylistTemplate}" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick" Background="Transparent" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="14">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="6,0,0,4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Content="重命名" Click="RenamePlaylist_Click" />
                                    <Button Content="移除歌曲" Click="RemoveSelectedTracks_Click" />
                                    <Button Content="删除歌单" Click="DeletePlaylist_Click" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="PlaylistTracksList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tracks}" ItemTemplate="{StaticResource TrackRowTemplate}" SelectionMode="Extended" IsItemClickEnabled="True" ItemClick="Track_ItemClick" Background="Transparent" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="LocalPanel" Visibility="Collapsed" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="本地音乐" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="专辑与歌曲" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="导入文件夹" Click="ImportFolder_Click" /><Button Content="刷新" Click="Refresh_Click" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="10">
                    <GridView ItemsSource="{x:Bind ViewModel.Tracks}" ItemTemplate="{StaticResource AlbumTileTemplate}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="190" ItemHeight="238" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                </Border>
            </Grid>

            <Grid x:Name="DownloadsPanel" Visibility="Collapsed" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource GlassCardStyle}" Padding="16"><Grid><TextBlock Text="下载管理" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="刷新" HorizontalAlignment="Right" Click="RefreshDownloads_Click" /></Grid></Border>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Downloads}" ItemTemplate="{StaticResource DownloadTemplate}" Background="Transparent" />
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Center">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Margin="4,0,0,18" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="18">
                                <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="窗口与玻璃材质" /><TextBlock Text="选择原生云母、云母 Alt 或亚克力" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><ComboBox x:Name="BackdropCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Left" SelectionChanged="BackdropCombo_SelectionChanged"><ComboBoxItem Content="纯色" Tag="none" /><ComboBoxItem Content="云母（Mica）" Tag="mica" /><ComboBoxItem Content="云母 Alt（Mica Alt）" Tag="micaAlt" /><ComboBoxItem Content="亚克力（Acrylic）" Tag="acrylic" /></ComboBox></Grid>
                                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="主题" /><TextBlock Text="沿用原版主题与强调色" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_SelectionChanged" /></Grid>
                                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="语言" VerticalAlignment="Center" /><ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"><ComboBoxItem Content="简体中文" Tag="zh-cn" /><ComboBoxItem Content="繁體中文" Tag="zh-tw" /><ComboBoxItem Content="English" Tag="en-us" /></ComboBox></Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="18">
                                <TextBlock Text="音源与输出" FontSize="20" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="在线音源脚本" /><TextBlock Text="使用原版 user_api.json" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><ComboBox x:Name="ApiCombo" Grid.Column="1" MinWidth="320" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="ApiCombo_SelectionChanged" /></Grid>
                                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="音频输出" /><TextBlock Text="Windows 原生 AudioGraph 输出设备" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><ComboBox x:Name="AudioDeviceCombo" Grid.Column="1" MinWidth="360" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="AudioDeviceCombo_SelectionChanged" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="音效" FontSize="20" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="EqualizerToggle" Header="十段均衡器" OnContent="开启" OffContent="关闭" Toggled="EqualizerToggle_Toggled" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"><StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Width="56"><TextBlock Text="31" HorizontalAlignment="Center" /><Slider x:Name="Eq31" Tag="0" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="62" HorizontalAlignment="Center" /><Slider x:Name="Eq62" Tag="1" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="125" HorizontalAlignment="Center" /><Slider x:Name="Eq125" Tag="2" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="250" HorizontalAlignment="Center" /><Slider x:Name="Eq250" Tag="3" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="500" HorizontalAlignment="Center" /><Slider x:Name="Eq500" Tag="4" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="1k" HorizontalAlignment="Center" /><Slider x:Name="Eq1000" Tag="5" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="2k" HorizontalAlignment="Center" /><Slider x:Name="Eq2000" Tag="6" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="4k" HorizontalAlignment="Center" /><Slider x:Name="Eq4000" Tag="7" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="8k" HorizontalAlignment="Center" /><Slider x:Name="Eq8000" Tag="8" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                    <StackPanel Width="56"><TextBlock Text="16k" HorizontalAlignment="Center" /><Slider x:Name="Eq16000" Tag="9" Height="140" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="1" ValueChanged="EqualizerSlider_ValueChanged" /><TextBlock Text="Hz" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
                                </StackPanel></ScrollViewer>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="原生混响" VerticalAlignment="Center" /><Slider x:Name="ReverbSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="ReverbSlider_ValueChanged" AutomationProperties.Name="混响比例" /></Grid>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="回声比例" VerticalAlignment="Center" /><Slider x:Name="EchoMixSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="EchoSlider_ValueChanged" AutomationProperties.Name="回声比例" /></Grid>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="回声延迟（毫秒）" VerticalAlignment="Center" /><Slider x:Name="EchoDelaySlider" Grid.Column="1" Minimum="1" Maximum="1000" StepFrequency="10" Value="180" ValueChanged="EchoSlider_ValueChanged" AutomationProperties.Name="回声延迟" /></Grid>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="回声反馈" VerticalAlignment="Center" /><Slider x:Name="EchoFeedbackSlider" Grid.Column="1" Minimum="0" Maximum="90" StepFrequency="5" Value="20" ValueChanged="EchoSlider_ValueChanged" AutomationProperties.Name="回声反馈" /></Grid>
                                <ToggleSwitch x:Name="VisualizationToggle" Header="播放器实时频谱" OnContent="开启" OffContent="关闭" Toggled="VisualizationToggle_Toggled" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="功能" FontSize="20" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="DesktopLyricToggle" Header="桌面歌词" OnContent="开启" OffContent="关闭" Toggled="DesktopLyricToggle_Toggled" />
                                <ToggleSwitch x:Name="TrayToggle" Header="系统托盘" OnContent="开启" OffContent="关闭" Toggled="TrayToggle_Toggled" />
                                <ToggleSwitch x:Name="SyncToggle" Header="局域网同步服务" OnContent="开启" OffContent="关闭" Toggled="SyncToggle_Toggled" />
                                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="服务端口" VerticalAlignment="Center" /><TextBox x:Name="SyncPortBox" Width="120" Text="23332" /></StackPanel>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="播放速度" VerticalAlignment="Center" /><Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="SpeedSlider_ValueChanged" AutomationProperties.Name="播放速度" /></Grid>
                                <ToggleSwitch x:Name="AutoUpdateToggle" Header="自动检查更新" OnContent="开启" OffContent="关闭" Toggled="AutoUpdateToggle_Toggled" />
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Floating glass player, intentionally overlays the page like the original app. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Height="124"
                Margin="88,0,28,18"
                VerticalAlignment="Bottom"
                Background="{StaticResource GlassBrush}"
                BorderBrush="#B3D5E5F6"
                BorderThickness="1"
                CornerRadius="30"
                Padding="26,14">
            <Grid RowSpacing="5">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="17" VerticalAlignment="Center">
                        <Border Width="70" Height="70" CornerRadius="15" Background="#29384A">
                            <Grid><FontIcon Glyph="&#xE8D6;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{x:Bind ViewModel.CurrentTrack.PictureUrl, Mode=OneWay}" Stretch="UniformToFill" /></Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="270">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Singer, Mode=OneWay}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.AlbumName, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE892;" Command="{x:Bind ViewModel.PreviousCommand}" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首" />
                        <Button Width="56" Height="56" CornerRadius="28" Background="{StaticResource ActiveBlueBrush}" Foreground="White" BorderThickness="0" FontFamily="Segoe Fluent Icons" FontSize="22" Content="&#xE768;" Command="{x:Bind ViewModel.TogglePlayCommand}" ToolTipService.ToolTip="播放或暂停" AutomationProperties.Name="播放或暂停" />
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE893;" Command="{x:Bind ViewModel.NextCommand}" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xEB51;" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏" />
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE896;" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载当前歌曲" />
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE8EE;" Command="{x:Bind ViewModel.CyclePlaybackModeCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.PlaybackModeText, Mode=OneWay}" AutomationProperties.Name="切换播放模式" />
                        <Button Style="{StaticResource RoundIconButtonStyle}" Content="&#xE8FD;" ToolTipService.ToolTip="播放列表" AutomationProperties.Name="播放列表" />
                        <FontIcon Glyph="&#xE767;" Foreground="#314158" FontSize="18" Margin="5,0,0,0" />
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="音量" />
                    </StackPanel>
                    <controls:SpectrumVisualizer x:Name="SpectrumView" Grid.Column="1" Height="28" Margin="190,22,190,0" VerticalAlignment="Bottom" Opacity="0.45" IsHitTestVisible="False" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="10" Margin="78,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.001" ValueChanged="ProgressSlider_ValueChanged" AutomationProperties.Name="播放进度" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
