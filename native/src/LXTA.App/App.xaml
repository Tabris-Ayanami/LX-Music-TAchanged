<Application
    x:Class="LXTA.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ShellBackgroundColor">#EEF4FC</Color>
                    <Color x:Key="SidebarBackgroundColor">#DDEAFB</Color>
                    <Color x:Key="SurfaceColor">#ECF8FBFF</Color>
                    <Color x:Key="SurfaceStrongColor">#FAFFFFFF</Color>
                    <Color x:Key="PrimaryColor">#397FE9</Color>
                    <Color x:Key="PrimarySoftColor">#C9DDF9</Color>
                    <Color x:Key="TextColor">#182235</Color>
                    <Color x:Key="MutedTextColor">#738198</Color>
                    <Color x:Key="LineColor">#B6CCE8</Color>
                    <Color x:Key="HoverColor">#B8D3F7</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ShellBackgroundColor">#0D131D</Color>
                    <Color x:Key="SidebarBackgroundColor">#172237</Color>
                    <Color x:Key="SurfaceColor">#E8141C28</Color>
                    <Color x:Key="SurfaceStrongColor">#FA1B2533</Color>
                    <Color x:Key="PrimaryColor">#438AF2</Color>
                    <Color x:Key="PrimarySoftColor">#294466</Color>
                    <Color x:Key="TextColor">#EAF1FF</Color>
                    <Color x:Key="MutedTextColor">#98A7BD</Color>
                    <Color x:Key="LineColor">#38506F</Color>
                    <Color x:Key="HoverColor">#294A74</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource ShellBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{ThemeResource SurfaceStrongColor}" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource PrimaryColor}" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="{ThemeResource PrimarySoftColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource TextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource MutedTextColor}" />
            <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource LineColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="{ThemeResource HoverColor}" />

            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="LibraryListViewStyle" TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="IsItemClickEnabled" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
