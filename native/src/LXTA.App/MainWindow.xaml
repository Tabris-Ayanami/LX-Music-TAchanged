<Window
    x:Class="LXTA.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LX Music">

    <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{ThemeResource SidebarBackgroundBrush}"
                BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="24,18,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="13" Background="{ThemeResource PrimaryBrush}">
                        <FontIcon Glyph="&#xE189;" Foreground="White" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LX MUSIC" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock Text="NATIVE · SLICE 1" FontSize="9" CharacterSpacing="140" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="DISCOVER" Margin="5,18,0,7" FontSize="10"
                           CharacterSpacing="160" Foreground="{ThemeResource MutedTextBrush}" />
                <StackPanel Grid.Row="2" Spacing="2">
                    <Button Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="在线搜索将在后续切片实现">
                        <Grid><FontIcon Glyph="&#xE721;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="搜索" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="在线歌单将在后续切片实现">
                        <Grid><FontIcon Glyph="&#xE93C;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="歌单" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="下载将在后续切片实现">
                        <Grid><FontIcon Glyph="&#xE896;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="下载" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="LOCAL" Margin="5,18,0,7" FontSize="10"
                           CharacterSpacing="160" Foreground="{ThemeResource MutedTextBrush}" />
                <StackPanel Grid.Row="4" Spacing="2">
                    <Button x:Name="TracksNavButton" Tag="tracks" Style="{StaticResource SidebarButtonStyle}" Click="NavigationButton_Click">
                        <Grid><FontIcon Glyph="&#xE8D6;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="歌曲" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                    <Button x:Name="AlbumsNavButton" Tag="albums" Style="{StaticResource SidebarButtonStyle}" Click="NavigationButton_Click">
                        <Grid><FontIcon Glyph="&#xE93C;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="专辑" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                    <Button x:Name="ArtistsNavButton" Tag="artists" Style="{StaticResource SidebarButtonStyle}" Click="NavigationButton_Click">
                        <Grid><FontIcon Glyph="&#xE77B;" FontSize="17" HorizontalAlignment="Left" /><TextBlock Text="歌手" Margin="38,0,0,0" FontWeight="SemiBold" /></Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="6" Padding="12" CornerRadius="14" Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="只读曲库" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock Text="Electron 数据不会被修改" FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Grid.Row="0" Padding="30,0,150,0"
              Background="Transparent">
            <TextBlock Text="Time slows down when it can get no worse"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource MutedTextBrush}" FontSize="14" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ThemeButton" Width="38" Height="38" Padding="0" CornerRadius="19"
                        Background="{ThemeResource SurfaceStrongBrush}" BorderBrush="{ThemeResource LineBrush}"
                        BorderThickness="1" Click="ThemeButton_Click" ToolTipService.ToolTip="切换明暗主题">
                    <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Padding="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border x:Name="LibrarySurface" CornerRadius="20" Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                <Grid Padding="20,18,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本地音乐" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock Text="{Binding ResultSummary}" Margin="0,3,0,0" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="TracksViewButton" Tag="tracks" Content="歌曲" Style="{StaticResource PillButtonStyle}" Click="NavigationButton_Click" />
                            <Button x:Name="AlbumsViewButton" Tag="albums" Content="专辑" Style="{StaticResource PillButtonStyle}" Click="NavigationButton_Click" />
                            <Button x:Name="ArtistsViewButton" Tag="artists" Content="歌手" Style="{StaticResource PillButtonStyle}" Click="NavigationButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,14" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="44" CornerRadius="14" PlaceholderText="搜索本地歌曲、歌手、专辑"
                                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="搜索本地曲库">
                            <TextBox.Header>
                                <TextBlock Visibility="Collapsed" />
                            </TextBox.Header>
                        </TextBox>
                        <ComboBox x:Name="AvailabilityBox" Grid.Column="1" Height="44" CornerRadius="12" SelectedIndex="0"
                                  SelectionChanged="AvailabilityBox_SelectionChanged" AutomationProperties.Name="按文件状态筛选">
                            <ComboBoxItem Content="全部状态" />
                            <ComboBoxItem Content="文件可用" />
                            <ComboBoxItem Content="文件缺失" />
                        </ComboBox>
                        <ComboBox x:Name="SortBox" Grid.Column="2" Height="44" CornerRadius="12" SelectedIndex="0"
                                  SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="排序方式">
                            <ComboBoxItem Content="原始顺序" />
                            <ComboBoxItem Content="歌曲名" />
                            <ComboBoxItem Content="艺术家" />
                            <ComboBoxItem Content="专辑名" />
                            <ComboBoxItem Content="时长" />
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="LibraryContent" Grid.Row="2">
                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="34" Height="34" />
                            <TextBlock Text="正在读取 Electron 本地曲库…" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xEA39;" FontSize="34" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="无法读取本地曲库" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SourceDatabasePath}" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>

                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="38" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="没有匹配到本地音乐" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="尝试清除搜索或更改文件状态筛选。" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>

                        <Grid x:Name="TrackView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="12,0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="歌曲名" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Grid.Column="2" Text="艺术家" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Grid.Column="3" Text="专辑名" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Grid.Column="4" Text="时长" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Grid.Column="5" Text="状态" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                            </Grid>
                            <ListView x:Name="TrackList" Grid.Row="1" ItemsSource="{Binding VisibleTracks}"
                                      Style="{StaticResource LibraryListViewStyle}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="52" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="CornerRadius" Value="10" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50" Padding="12,0" ColumnSpacing="16" ToolTipService.ToolTip="{Binding FilePath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayOrder}" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="local" FontSize="10" Foreground="{ThemeResource PrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayArtist}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayAlbum}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Duration}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding FileStatus}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <GridView x:Name="GroupGrid" Visibility="Collapsed" ItemsSource="{Binding VisibleGroups}"
                                  IsItemClickEnabled="True" ItemClick="GroupGrid_ItemClick" SelectionMode="None"
                                  Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="6" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="246" Height="116" Padding="14" CornerRadius="18"
                                            Background="{ThemeResource SurfaceStrongBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="86" Height="86" CornerRadius="18" Background="{ThemeResource PrimarySoftBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" />
                                                    <Image Source="{Binding ArtworkUri}" Stretch="UniformToFill" Loaded="GroupArtwork_Loaded" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Grid x:Name="GroupDetail" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Width="42" Height="42" CornerRadius="21" Padding="0" Click="BackToGroups_Click" AutomationProperties.Name="返回分组列表">
                                    <FontIcon Glyph="&#xE72B;" FontSize="17" />
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGroup.Title}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedGroup.Subtitle}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{Binding DetailTracks}" Style="{StaticResource LibraryListViewStyle}">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="52" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="10" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="52" Padding="14,0" ColumnSpacing="16" ToolTipService.ToolTip="{Binding FilePath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayOrder}" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayArtist}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayAlbum}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Duration}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock Text="{Binding SourceDatabasePath}" HorizontalAlignment="Right" MaxWidth="620"
                                   TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="19" Background="{ThemeResource SurfaceStrongBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                <Grid Padding="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="READ-ONLY LOCAL LIBRARY" FontSize="10" CharacterSpacing="130" Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock Text="浏览已就绪 · 播放尚未进入本切片" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" IsEnabled="False"><FontIcon Glyph="&#xE892;" FontSize="15" /></Button>
                        <Button Width="44" Height="44" Padding="0" CornerRadius="22" IsEnabled="False"><FontIcon Glyph="&#xE768;" FontSize="18" /></Button>
                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" IsEnabled="False"><FontIcon Glyph="&#xE893;" FontSize="15" /></Button>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="SLICE 1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource MutedTextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
