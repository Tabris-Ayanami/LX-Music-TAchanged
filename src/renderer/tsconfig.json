{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "paths": {                                           /* Specify a set of entries that re-map imports to additional lookup locations. */
      "@common/*": ["common/*"],
      "@renderer/*": ["renderer/*"],
      // "@lyric/*": ["renderer-lyric/*"],
      "@static/*": ["static/*"],
      "@root/*": ["./*"],
    },
    "typeRoots": [                                       /* Specify multiple folders that act like './node_modules/@types'. */
      "./types"
    ],
  },
  "vueCompilerOptions": {
    "plugins": [
      "@vue/language-plugin-pug"
    ]
  },
  "exclude": [
    "vendor/folia/components/visualizer/backgrounds/**/*",
    "vendor/folia/components/visualizer/registry.tsx",
    "vendor/folia/components/visualizer/tuningRegistry.ts",
    "vendor/folia/components/visualizer/VisualizerRenderer.tsx",
    "vendor/folia/components/visualizer/VisPlayground*.tsx",
    "vendor/folia/components/visualizer/useVisPlayground*.ts",
    "vendor/folia/components/visualizer/FontFallbackStackControl.tsx",
    "vendor/folia/components/visualizer/PreviewPlaceholder.ts",
    "vendor/folia/components/visualizer/settingsPanels.tsx",
    "vendor/folia/components/visualizer/*/entry.tsx",
    "vendor/folia/components/visualizer/*/tuning.ts",
    "vendor/folia/components/visualizer/**/*SettingsPanel.tsx"
  ]
  // "include": [
	//   "./**/*.ts",
	//   // "./**/*.js",
	//   "./**/*.vue",
	//   "./**/*.json",
	// ],
}
